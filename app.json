{
  "expo": {
    "name": "Crunchy Living",
    "slug": "crunchy-app",
    "scheme": "crunchy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crunchyapp.ios",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cleothecooldev.crunchyapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "owner": "cleothecooldev",
    "runtimeVersion": "exposdk:55.0.0",
    "updates": {
      "url": "https://u.expo.dev/9bf7d334-4566-40dc-85ab-e49c856c8d7b"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9bf7d334-4566-40dc-85ab-e49c856c8d7b"
      }
    }
  }
}